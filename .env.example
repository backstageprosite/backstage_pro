# ==============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO LOCAL (.env)
# ==============================================================================
# O arquivo .env será lido apenas em ambiente de desenvolvimento local (DJANGO_ENV=development).
# Em produção (Railway ou DJANGO_ENV=production|staging), a carga local é BLOQUEADA.

# AMBIENTE (obrigatório: development, test, staging, production)
DJANGO_ENV=development

# DEBUG (True para desenvolvimento local)
DEBUG=True

# DATABASE LOCAL (Deixe em branco para usar SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/backstage_pro

# HOSTS (Local)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ==============================================================================
# ASAAS GATEWAY (SANDBOX / LOCAL)
# ==============================================================================
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=sua_api_key_sandbox_aqui

# ==============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO (NA RAILWAY APENAS)
# ==============================================================================
# As seguintes variáveis DEVEM ser configuradas no painel da Railway:
#
# DATABASE_URL=postgres://... (Fornecido pelo banco da Railway)
# SECRET_KEY=minha-chave-forte-com-mais-de-50-caracteres
# DJANGO_ENV=production
# SECURE_SSL_REDIRECT=1
#
# (RAILWAY_PUBLIC_DOMAIN é injetado automaticamente pelo sistema da Railway.
#  ALLOWED_HOSTS e CSRF_TRUSTED_ORIGINS farão a autoconfiguração a partir dele.
#  NÃO use * nesses campos em hipótese alguma.)

ASAAS_WEBHOOK_TOKEN=
PAYMENT_TOKEN_ENCRYPTION_KEY=

# Google Calendar Integration (BP-PEND-48)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
